<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for the WebView wrapper — RELEASE default.

  The web app is served over HTTPS on the trusted Freebuff origin, so this
  base configuration:
    • forbids cleartext traffic everywhere (no wildcard exceptions),
    • trusts only system CAs.

  Debug builds get their own overlay (src/debug/...) that additionally
  permits cleartext to localhost/emulator hosts for local development; it is
  never part of a release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
