#!/bin/sh

# Gradle wrapper launcher (POSIX sh). Downloads the Gradle distribution
# pinned in gradle/wrapper/gradle-wrapper.properties on first run, then
# delegates to it. Requires a JDK (17+) on PATH or via JAVA_HOME.

APP_BASE_NAME=$(basename "$0")
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

exec "$JAVACMD" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
