# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Downloaded runtime binaries (yt-dlp) — never commit binaries
.runtime/

# Playwright test artifacts (browser fixtures are generated per-run)
.runtime/playwright-artifacts/
test-results/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/

# Android build artifacts (added in later prompts)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/
*.apk
*.aab
*.keystore
